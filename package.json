{
  "name": "devtrust.ru",
  "version": "1.0.0",
  "private": true,
  "description": "Платформа-магазин бизнес-приложений",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "build:core": "turbo build --filter=@platform/core"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@sentry/cli",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "turbo": "^2.9.9",
    "typescript": "^5.7.0"
  }
}