FROM node:24 AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

WORKDIR /app

# Copy root config files
COPY package.json pnpm-workspace.yaml .npmrc ./

# Copy package.json files
COPY apps/web/package.json apps/web/
COPY packages/core/package.json packages/core/

# Install dependencies with build scripts enabled
RUN pnpm install --no-frozen-lockfile --config.enable-pre-post-scripts=true

# Copy source code
COPY apps/web apps/web
COPY packages/core packages/core
COPY packages packages

# Generate Prisma client
RUN cd apps/web && npx prisma@5.22.0 generate

WORKDIR /app/apps/web

ENV NODE_ENV=development
ENV PORT=3000

EXPOSE 3000

CMD ["sh", "-c", "pnpm exec prisma db push --accept-data-loss && pnpm exec prisma db seed && pnpm dev"]
